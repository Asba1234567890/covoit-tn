# Postgres connection string (Supabase or any Postgres instance).
# The app connects via Prisma using a trusted server-side role; this
# role must NOT be exposed to the client and must never be committed
# with a real value.
DATABASE_URL="postgresql://user:password@host:5432/covoit_tn"

# Meta WhatsApp Cloud API — used to send the OTP login code.
# All five are required; the app fails closed with a clear error if any
# are missing rather than falling back to logging the code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=

# NODE_ENV is set automatically by the hosting platform (e.g. Vercel) —
# no need to set it manually. It controls cookie Secure flag behavior.
