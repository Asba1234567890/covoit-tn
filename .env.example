# Postgres connection string (Supabase or any Postgres instance).
# The app connects via Prisma using a trusted server-side role; this
# role must NOT be exposed to the client and must never be committed
# with a real value.
DATABASE_URL="postgresql://user:password@host:5432/covoit_tn"

# Meta WhatsApp Cloud API — used to send the OTP login code.
# All five are required; the app fails closed with a clear error if any
# are missing rather than falling back to logging the code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=

# Supabase Storage — used to upload profile and vehicle photos
# (app/api/upload/route.ts, lib/supabaseAdmin.ts). SUPABASE_SERVICE_ROLE_KEY
# bypasses Storage RLS entirely, so it must only ever be used server-side
# (never NEXT_PUBLIC_) and never committed with a real value. Find both in
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform — powers geocoding/routing (server, lib/map/GoogleMapProvider.ts)
# and the interactive route map (client, components/RouteMap.tsx). Needs the
# Geocoding API, Directions API, Places API, and Maps JavaScript API enabled
# in Google Cloud Console, plus billing enabled on the project (required by
# Google for all Maps Platform APIs, even within the free monthly credit).
#
# GOOGLE_MAPS_API_KEY is a server-side secret — never exposed to the
# browser — and should be restricted by IP address + API in the console.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY IS sent to the browser (that's how the
# Maps JavaScript API works); restrict it by HTTP referrer instead of
# treating it as secret. These can be the same key value if its
# restrictions allow both usages, or two separate keys for tighter scoping.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# NODE_ENV is set automatically by the hosting platform (e.g. Vercel) —
# no need to set it manually. It controls cookie Secure flag behavior.
